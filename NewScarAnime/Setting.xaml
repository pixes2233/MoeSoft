<Page x:Class="MoeSoft.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoeSoft"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1366"
      Title="Setting">

    <ScrollViewer>
        <StackPanel Margin="10,10,10,20">

            <!-- 可选：添加一个小标题，增加界面的模块感 -->
            <TextBlock 
                Text="网络与代理" 
                FontSize="14" 
                FontWeight="SemiBold" 
                Margin="14,10,10,8" 
                Opacity="0.8"/>

            <!-- 1. 启用 Proxy 代理开关 -->
            <ui:CardControl Margin="0,0,0,4" Padding="16,12">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Globe24" FontSize="24" />
                </ui:CardControl.Icon>

                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center" Margin="8,0,16,0">
                        <TextBlock
                            Text="启用 Proxy 代理"
                            FontSize="16"
                            FontWeight="Medium" />

                        <TextBlock
                            Text="开启后，网络请求将通过指定的代理服务器转发"
                            FontSize="12"
                            Opacity="0.6"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>

                <!-- 重点：给 ToggleSwitch 起一个名字叫 ProxyToggle，方便下面去绑定它 -->
                <ui:ToggleSwitch x:Name="ProxyToggle" VerticalAlignment="Center" Checked="ProxyToggle_Checked" Unchecked="ProxyToggle_Unchecked"/>

            </ui:CardControl>

            <!-- 2. Proxy 地址输入框与测试按钮 -->
            <ui:CardControl Margin="0,0,0,0" Padding="16,12">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Server24" FontSize="24" />
                </ui:CardControl.Icon>

                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center" Margin="8,0,16,0">
                        <TextBlock
                            Text="代理服务器地址"
                            FontSize="16"
                            FontWeight="Medium" />

                        <TextBlock
                            Text="支持 HTTP 或 SOCKS5 协议"
                            FontSize="12"
                            Opacity="0.6"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>

                <!-- 修改部分：用横向 StackPanel 包裹 TextBox 和 Button -->
                <!-- 并且将 IsEnabled 统一绑定在 StackPanel 上，开关关闭时两者一起禁用 -->
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            IsEnabled="{Binding IsChecked, ElementName=ProxyToggle}">

                    <ui:TextBlock 
                        x:Name="ProxyConnctionStatus"
                        Text="连接状态: 未测试"
                        FontSize="16"
                        FontWeight="Bold"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="#607D8B"/>

                    <ui:TextBox 
                        x:Name="ProxyAddressTextBox"
                        Width="280" 
                        VerticalAlignment="Center"
                        PlaceholderText="例如: http://127.0.0.1:7890" 
                        TextChanged="ProxyAddressTextBox_TextChanged"
                        Margin="0,0,8,0"/>
                    <!-- 加上右边距 8，与按钮拉开距离 -->

                    <!-- 添加了 ui:Button 测试连接按钮 -->
                    <ui:Button 
                        x:Name="TestConnectionButton"
                        Content="测试连接"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Click="TestConnectionButton_Click" />

                </StackPanel>

            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Padding="16,12">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Globe24" FontSize="24" />
                </ui:CardControl.Icon>

                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center" Margin="8,0,16,0">
                        <TextBlock
                Text="播放方式"
                FontSize="16"
                FontWeight="Medium" />

                        <TextBlock
                Text="选择你的播放器"
                FontSize="12"
                Opacity="0.6"
                Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>

                <StackPanel Orientation="Horizontal" 
            VerticalAlignment="Center" >

                    <ui:TextBlock 
                    x:Name="PlayerName"
        Text=""
        FontSize="16"
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Foreground="#FFFFFF"/>

                    <ui:Button x:Name="PlayerSelectButton" VerticalAlignment="Center" Content="选择播放器" Click="PlayerSelectButton_Click"/>
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>